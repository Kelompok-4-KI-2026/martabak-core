# Environment Configuration for Martabak Core
# Salin file ini menjadi .env dan isi dengan kredensial Supabase Anda:
# cp .env.example .env

# Database Supabase (PostgreSQL)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres (Transaction/Session Pooler)
# Atau Direct Connection: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./martabak.db

# App Security
SECRET_KEY=martabak-core-ultra-secure-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=120
