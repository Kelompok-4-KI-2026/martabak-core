# Martabak Core — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit the real .env file.

# Supabase PostgreSQL Connection String (REQUIRED — no default)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Application Secret Key for session signing (REQUIRED — no default, use a long random string)
# Example generation:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="your-strong-random-secret-key"

# Supabase Storage credentials — enables remote storage mode (private buckets)
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"

# Optional tuning
ACCESS_TOKEN_EXPIRE_MINUTES="120"

# Optional overrides (defaults shown) — local fallback dirs, dev/tests only
# STORAGE_DIR="./encrypted_storage"
# KEYS_DIR="./keys"
# SUPABASE_BUCKET_ENCRYPTED="encrypted-storage"
# SUPABASE_BUCKET_KEYS="keys"
